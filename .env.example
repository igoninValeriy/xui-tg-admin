# Logging
LOG_LEVEL=info

# Telegram bot
TG_TOKEN=your_bot_token_here
TG_ADMIN_IDS=123456789,987654321

# 3x-ui panel: base URL including the secret web base path, no trailing slash
XRAY_API_URL=http://localhost:2053/secretpath
XRAY_USER=admin
XRAY_PASSWORD=admin

# Optional API token; replaces the username/password login when set
# XRAY_API_TOKEN=

# Base URL of the subscription front end; a link is {prefix}/{subId}
XRAY_SUB_URL_PREFIX=https://sub.example.com
