# Example configuration for local testing

# Telegram Bot Configuration
TG_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890
TG_ADMIN_IDS=123456789,987654321

# 3x-ui Panel Configuration
# XRAY_API_URL is the panel base URL including its secret web base path, with no
# trailing slash: the bot calls {XRAY_API_URL}/login and {XRAY_API_URL}/panel/api/...
# under it.
XRAY_API_URL=http://localhost:2053/secretpath
XRAY_USER=admin
XRAY_PASSWORD=password123

# Optional: a panel API token (Settings -> Security -> API Token). When set it
# replaces XRAY_USER/XRAY_PASSWORD and skips the CSRF handshake. Treat it like
# the panel password — it is a full-admin credential.
# XRAY_API_TOKEN=

# Base URL of whatever serves subscriptions. The bot builds a user's link as
# {XRAY_SUB_URL_PREFIX}/{subId}. This is the panel's own subscription service in
# a default install, but it can be any front end (e.g. a Cloudflare Worker).
XRAY_SUB_URL_PREFIX=https://sub.example.com

# Logging Configuration
LOG_LEVEL=debug

# The Node Status and Subscriptions screens read the host the bot runs on:
# /etc/vpn-dest, /var/log/vpn-watchdog.log, /usr/local/bin/vpn-sub-stats and the
# ss/systemctl/uptime/free/df tools. Those paths are constants (see
# internal/constants), not environment variables, so there is nothing to set
# here — but the bot must run on that host (and as root) for those two screens
# to show anything other than "no data".
